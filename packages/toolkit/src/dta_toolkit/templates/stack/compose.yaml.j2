# Stack of the twin "{{ twin_id }}". Written by the toolkit from the manifest:
# change the manifest and build again instead of editing this file.
#
# Every value that differs between machines, and every secret, comes from the
# workspace's .env file; compose refuses to start while one is missing.
# Host ports are bound to the loopback interface only.

name: {{ project }}

x-runtime: &runtime
  image: {{ runtime_image }}
  restart: unless-stopped
  logging: &logging
    driver: json-file
    options:
      max-size: "10m"
      max-file: "3"

services:
  store:
    image: {{ store_image }}
    restart: unless-stopped
    logging: *logging
    environment:
      DOLT_ROOT_PASSWORD: ${{ '{' }}{{ store_password_env }}:?{{ store_password_env }} is required}
      DOLT_ROOT_HOST: "%"
    volumes:
      - store-data:/var/lib/dolt
{%- if readonly_sql %}
    # Read-only SQL: the user who may read only this twin's database signs in here.
    ports:
      - "127.0.0.1:${{ '{' }}{{ sql_port_env }}:?{{ sql_port_env }} is required}:3306"
{%- endif %}
    healthcheck:
      test:
        - CMD-SHELL
        # The password goes by the environment: an argument would show in the host's process list.
        - DOLT_CLI_PASSWORD="$$DOLT_ROOT_PASSWORD" dolt --host 127.0.0.1 --port 3306 --user root --no-tls sql -q "select 1"
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 5s

  api:
    <<: *runtime
    command: ["dta-runtime", "api"]
    # The API sets up its notifications and the executors of its actions once, when it
    # starts; this digest of what they are made from changes with them, and compose then
    # starts the API anew.
    labels:
      dta.api-start: "{{ api_start }}"
    depends_on:
      store:
        condition: service_healthy
    environment:
      DTA_STORE_HOST: store
      DTA_STORE_PORT: "3306"
      DTA_STORE_USER: root
      DTA_STORE_PASSWORD: ${{ '{' }}{{ store_password_env }}:?{{ store_password_env }} is required}
      DTA_STORE_DATABASE: {{ database }}
      DTA_API_TOKEN: ${{ '{' }}{{ token_env }}:?{{ token_env }} is required}
      DTA_ARTIFACTS_DIR: /var/lib/dta/artifacts
      DTA_LOGS_DIR: /var/log/dta
{%- if worker %}
      DTA_WORKER_URL: http://worker:8100
{%- endif %}
{%- for name in source_env %}
      {{ name }}: ${{ '{' }}{{ name }}:?{{ name }} is required}
{%- endfor %}
{%- for name in api_env if name not in source_env %}
      {{ name }}: ${{ '{' }}{{ name }}:?{{ name }} is required}
{%- endfor %}
    volumes:
      - artifacts:/var/lib/dta/artifacts
      - logs:/var/log/dta
{%- for mount in source_mounts %}
      # A source that is a folder on this machine, readable and nothing more.
      - {{ mount.host }}:{{ mount.container }}:ro
{%- endfor %}
{%- if networks or worker %}
    # Only this service reads sources, so only it joins the networks they live on;
    # only it talks to the worker, on a network of their own.
    networks:
      - default
{%- if worker %}
      - compute
{%- endif %}
{%- for network in networks %}
      - {{ network }}
{%- endfor %}
{%- endif %}
    ports:
      - "127.0.0.1:${{ '{' }}{{ api_port_env }}:?{{ api_port_env }} is required}:8000"
    healthcheck:
      test: ["CMD", "dta-runtime", "health", "api"]
      interval: 10s
      timeout: 10s
      retries: 12
      start_period: 20s
{%- if ui %}

  ui:
    <<: *runtime
    command: ["dta-runtime", "ui"]
    depends_on:
      api:
        condition: service_healthy
    environment:
      DTA_API_URL: http://api:8000
      DTA_API_TOKEN: ${{ '{' }}{{ token_env }}:?{{ token_env }} is required}
      DTA_LOGS_DIR: /var/log/dta
    volumes:
      - logs:/var/log/dta
    ports:
      - "127.0.0.1:${{ '{' }}{{ ui_port_env }}:?{{ ui_port_env }} is required}:8050"
    healthcheck:
      test: ["CMD", "dta-runtime", "health", "ui"]
      interval: 10s
      timeout: 10s
      retries: 12
      start_period: 20s
{%- endif %}
{%- if mcp %}

  # Offers the API to agents as MCP tools. It holds no token: every call carries the
  # token the agent sent. It reaches the API and nothing else.
  mcp:
    <<: *runtime
    command: ["dta-runtime", "mcp"]
    depends_on:
      api:
        condition: service_healthy
    environment:
      DTA_API_URL: http://api:8000
      DTA_LOGS_DIR: /var/log/dta
    volumes:
      - logs:/var/log/dta
    ports:
      - "127.0.0.1:${{ '{' }}{{ mcp_port_env }}:?{{ mcp_port_env }} is required}:{{ mcp_container_port }}"
    healthcheck:
      test: ["CMD", "dta-runtime", "health", "mcp"]
      interval: 10s
      timeout: 10s
      retries: 12
      start_period: 20s
{%- endif %}
{%- if live %}

  # Starts what is due on the twin's clock by calling the API. It holds the
  # token and nothing else: no store password, no source credential.
  scheduler:
    <<: *runtime
    command: ["dta-runtime", "scheduler"]
    depends_on:
      api:
        condition: service_healthy
    environment:
      DTA_API_URL: http://api:8000
      DTA_API_TOKEN: ${{ '{' }}{{ token_env }}:?{{ token_env }} is required}
      DTA_LOGS_DIR: /var/log/dta
      DTA_SCHEDULER_POLL_S: "{{ scheduler_poll_s }}"
    volumes:
      - logs:/var/log/dta
{%- endif %}
{%- if worker %}

  # Runs the twin's models and the code registered with it. It reaches the API
  # and nothing else: its network has no way out, it shares no volume, and it
  # holds no store password and no source credential. What a run logs comes
  # back with its result.
  worker:
    image: {{ worker_image }}
    restart: unless-stopped
    logging: *logging
    command: ["dta-runtime", "worker"]
    depends_on:
      api:
        condition: service_healthy
    environment:
      DTA_API_URL: http://api:8000
      DTA_API_TOKEN: ${{ '{' }}{{ token_env }}:?{{ token_env }} is required}
      DTA_WORKER_CPUS: "{{ worker_cpus }}"
      DTA_WORKER_MEMORY_MB: "{{ worker_memory_mb }}"
{%- for name in worker_env %}
      {{ name }}: ${{ '{' }}{{ name }}:?{{ name }} is required}
{%- endfor %}
    networks:
      - compute
    read_only: true
    tmpfs:
      - /tmp:size=1g,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 512
    cpus: {{ worker_cpus }}
    mem_limit: {{ worker_memory_mb }}m
    healthcheck:
      test: ["CMD", "dta-runtime", "health", "worker"]
      interval: 10s
      timeout: 10s
      retries: 12
      start_period: 20s
{%- endif %}

volumes:
  store-data: {}
  artifacts: {}
  logs: {}
{%- if networks or worker %}

networks:
  default: {}
{%- if worker %}
  compute:
    internal: true
{%- endif %}
{%- for network in networks %}
  {{ network }}:
    external: true
{%- endfor %}
{%- endif %}
