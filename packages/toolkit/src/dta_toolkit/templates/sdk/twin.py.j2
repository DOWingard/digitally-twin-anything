class TwinConfigError(RuntimeError):
    """The environment does not say where the twin is or how to sign in to it."""

    def __init__(self, missing: Sequence[str]) -> None:
        super().__init__(f"missing environment variables: {', '.join(missing)}")
        self.missing = list(missing)


class TwinApiError(RuntimeError):
    """The API refused a request, or could not answer it."""

    def __init__(self, status: int, code: str | None, message: str) -> None:
        super().__init__(f"HTTP {status}{f' {code}' if code else ''}: {message}")
        self.status = status
        self.code = code
        self.message = message


def _failure(status: int, content: bytes) -> TwinApiError:
    try:
        body = json.loads(content or b"{}")
    except ValueError:
        body = None
    if not isinstance(body, dict):
        return TwinApiError(status, None, content[:300].decode("utf-8", "replace"))
    message = body.get("detail") or body.get("title") or ""
    return TwinApiError(status, body.get("code"), str(message))


def _json(response: Response[Any]) -> dict[str, Any]:
    status = int(response.status_code)
    if not 200 <= status < 300:
        raise _failure(status, response.content)
    return json.loads(response.content)


@dataclass(frozen=True)
class Change:
    """What changed in one object at one version."""

    version: str
    seq: int
    t: str
    change: str
    values: dict[str, Any]


@dataclass(frozen=True)
class Link:
    """One edge of an object: a link object or a reference, and the object at its other end."""

    direction: str
    edge_type: str
    neighbor: str
    neighbor_type: str | None
    link_uid: str | None
    values: dict[str, Any]


class Objects(Generic[M]):
    """The objects of one type. Every read is of one version: `at` is `head`, a commit id,
    `#<seq>` or an ISO 8601 time with an offset (the last version at or before it)."""

    def __init__(self, client: AuthenticatedClient, type_name: str, model: type[M]) -> None:
        self._client = client
        self.type_name = type_name
        self.model = model

    def _typed(self, row: Mapping[str, Any]) -> M:
        known = self.model.model_fields
        return self.model.model_validate({k: v for k, v in row.items() if k in known})

    def get(self, uid: str, *, at: str = HEAD, branch: str = MAIN) -> M:
        """The object with this uid as of `at`."""
        response = _one.sync_detailed(
            {{ ops.one.kw.type }}=self.type_name,
            {{ ops.one.kw.uid }}=uid,
            client=self._client,
            {{ ops.one.kw.at }}=at,
            {{ ops.one.kw.branch }}=branch,
        )
        found = _json(response)["data"]
        return self._typed({**found["values"], "uid": found["uid"]})

    def list(
        self,
        *,
        at: str = HEAD,
        branch: str = MAIN,
        where: Sequence[str] = (),
        sort: str | None = None,
        limit: int | None = None,
    ) -> list[M]:
        """The objects as of `at`, every page of them unless `limit` says fewer.

        `where` holds filters `<property>:<op>:<value>`, op one of eq, ne, lt, le, gt,
        ge, in, like, null, notnull; `sort` a property, `-` in front for descending.
        """
        found: list[M] = []
        cursor: str | None = None
        while limit is None or len(found) < limit:
            size = PAGE_SIZE if limit is None else min(PAGE_SIZE, limit - len(found))
            page = _json(
                _list.sync_detailed(
                    {{ ops.list.kw.type }}=self.type_name,
                    client=self._client,
                    {{ ops.list.kw.at }}=at,
                    {{ ops.list.kw.branch }}=branch,
                    {{ ops.list.kw.where }}=list(where) or None,
                    {{ ops.list.kw.sort }}=sort,
                    {{ ops.list.kw.limit }}=size,
                    {{ ops.list.kw.cursor }}=cursor,
                )
            )
            found.extend(self._typed(row) for row in page["data"])
            cursor = page.get("next_cursor")
            if not cursor:
                break
        return found

    def history(
        self,
        uid: str,
        *,
        at: str = HEAD,
        since: str = "#0",
        properties: Sequence[str] = (),
        branch: str = MAIN,
    ) -> list[Change]:
        """Each change of the object from `since` up to `at`, oldest first; only of
        `properties` when they are given."""
        changes: list[Change] = []
        cursor: str | None = None
        while True:
            page = _json(
                _history.sync_detailed(
                    {{ ops.history.kw.type }}=self.type_name,
                    {{ ops.history.kw.uid }}=uid,
                    client=self._client,
                    {{ ops.history.kw.range }}=f"{since}..{at}",
                    {{ ops.history.kw.branch }}=branch,
                    {{ ops.history.kw.properties }}=list(properties) or None,
                    {{ ops.history.kw.limit }}=PAGE_SIZE,
                    {{ ops.history.kw.cursor }}=cursor,
                )
            )
            for row in page["data"]:
                values = {k: v for k, v in row.items() if not k.startswith("_") and k != "uid"}
                changes.append(
                    Change(
                        version=row.get("_version"),
                        seq=row.get("_seq"),
                        t=row.get("_t"),
                        change=row.get("_change"),
                        values=values,
                    )
                )
            cursor = page.get("next_cursor")
            if not cursor:
                return changes

    def links(
        self,
        uid: str,
        *,
        at: str = HEAD,
        direction: str = "both",
        edge_types: Sequence[str] = (),
        branch: str = MAIN,
    ) -> list[Link]:
        """The edges of the object as of `at`: `direction` `in`, `out` or `both`, only of
        `edge_types` when they are given."""
        found: list[Link] = []
        cursor: str | None = None
        named = {"direction", "edge_type", "neighbor", "neighbor_type", "link_uid"}
        while True:
            page = _json(
                _links.sync_detailed(
                    {{ ops.links.kw.type }}=self.type_name,
                    {{ ops.links.kw.uid }}=uid,
                    client=self._client,
                    {{ ops.links.kw.at }}=at,
                    {{ ops.links.kw.branch }}=branch,
                    {{ ops.links.kw.direction }}=_Direction(direction),
                    {{ ops.links.kw.edge_types }}=list(edge_types) or None,
                    {{ ops.links.kw.limit }}=PAGE_SIZE,
                    {{ ops.links.kw.cursor }}=cursor,
                )
            )
            for row in page["data"]:
                found.append(
                    Link(
                        direction=row.get("direction"),
                        edge_type=row.get("edge_type"),
                        neighbor=row.get("neighbor"),
                        neighbor_type=row.get("neighbor_type"),
                        link_uid=row.get("link_uid"),
                        values={k: v for k, v in row.items() if k not in named},
                    )
                )
            cursor = page.get("next_cursor")
            if not cursor:
                return found

    def table(
        self,
        *,
        at: str = HEAD,
        branch: str = MAIN,
        where: Sequence[str] = (),
        columns: Sequence[str] = (),
    ) -> pa.Table:
        """Every object as of `at` as one Arrow table, read in one answer."""
        request = _list._get_kwargs(
            {{ ops.list.kw.type }}=self.type_name,
            {{ ops.list.kw.at }}=at,
            {{ ops.list.kw.branch }}=branch,
            {{ ops.list.kw.where }}=list(where) or None,
            {{ ops.list.kw.columns }}=list(columns) or None,
            {{ ops.list.kw.format }}="arrow",
        )
        response = self._client.get_httpx_client().request(
            **request, headers={"Accept": ARROW}
        )
        if not 200 <= response.status_code < 300:
            raise _failure(response.status_code, response.content)
        with pyarrow.ipc.open_stream(response.content) as reader:
            return reader.read_all()


class _Arguments(dict):
    """The arguments of a question as the generated client sends a request body."""

    def to_dict(self) -> dict[str, Any]:
        return dict(self)


class Questions:
    """The twin's questions: one method each, and `ask` for any of them by id."""

    def __init__(self, client: AuthenticatedClient) -> None:
        self._client = client

    def ask(self, question_id: str, *, at: str = HEAD, branch: str = MAIN, **arguments: Any) -> Any:
        """The answer to the question as of `at`, as the API's `AnswerOut`."""
        response = _answer.sync_detailed(
            {{ ops.answer.kw.id }}=question_id,
            client=self._client,
            body=_Arguments(arguments),
            {{ ops.answer.kw.at }}=at,
            {{ ops.answer.kw.branch }}=branch,
        )
        status = int(response.status_code)
        if not 200 <= status < 300 or response.parsed is None:
            raise _failure(status, response.content)
        return response.parsed
