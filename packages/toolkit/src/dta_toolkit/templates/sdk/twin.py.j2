class Twin:
    """The twin {{ json.dumps(twin_name) }}: one accessor per object and link type, and its questions."""

    def __init__(
        self, *, environ: Mapping[str, str] | None = None, timeout_s: float = TIMEOUT_S
    ) -> None:
        source = os.environ if environ is None else environ
        missing = [name for name in (BASE_URL_ENV, TOKEN_ENV) if not source.get(name)]
        if missing:
            raise TwinConfigError(missing)
        self.base_url = source[BASE_URL_ENV].rstrip("/")
        self._client = AuthenticatedClient(
            base_url=self.base_url,
            token=source[TOKEN_ENV],
            timeout=httpx2.Timeout(timeout_s),
        )
{%- for type in types %}
        self.{{ type.attribute }}: Objects[types.{{ type.name }}] = Objects(
            self._client, {{ json.dumps(type.name) }}, types.{{ type.name }}
        )
{%- endfor %}
        self._by_type: dict[str, Objects[Any]] = {
{%- for type in types %}
            {{ json.dumps(type.name) }}: self.{{ type.attribute }},
{%- endfor %}
        }
        self.questions = Questions(self._client)

    def objects(self, type_name: str) -> Objects[Any]:
        """The accessor of a type by its name in the schema, as `TYPES` lists them."""
        if type_name not in self._by_type:
            raise KeyError(f"no type {type_name!r}; the types are {sorted(self._by_type)}")
        return self._by_type[type_name]

    def head(self, *, branch: str = MAIN) -> str:
        """The id of the newest version: pass it as `at` to read one state across calls."""
        response = _health.sync_detailed(client=self._client, {{ ops.head.kw.branch }}=branch)
        return str(_json(response)["head"]["id"])

    def __repr__(self) -> str:
        return f"Twin({self.base_url!r})"

    def close(self) -> None:
        self._client.get_httpx_client().close()

    def __enter__(self) -> Twin:
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()


